# Optional local configuration. The showcase also runs without any .env file.
# Do not copy credentials from another application into this repository.
MIMI_STORAGE_RUNTIME=local
MIMI_ENABLE_STORAGE_UI_WRITES=false
MIMI_ENABLE_STORAGE_SMOKE_WRITES=false

# Integration shapes only. Cloud features stay closed without their full
# environment, branch, identity, readiness, disclosure, and budget contracts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
MIMI_STUDY_TOKEN_SECRET=
GEMINI_API_KEY=
MIMI_AI_RUNTIME_ENABLED=false
MIMI_AI_KILL_SWITCH=true
MIMI_TTS_RUNTIME_ENABLED=false
MIMI_TTS_KILL_SWITCH=on

# Auth requires an explicitly configured deployment; no credentials are supplied.
MIMI_PRODUCTION_AUTH_MODE=cloudflare
MIMI_CF_ACCESS_TEAM_DOMAIN=
MIMI_CF_ACCESS_AUD=
MIMI_BASIC_AUTH_USER=
MIMI_BASIC_AUTH_PASSWORD=
